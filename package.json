{
  "name": "expiring-todo-comments-action",
  "version": "4.0.0",
  "description": "Add expiration conditions to TODO comments",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": "^24"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "format": "biome format --write .",
    "format-check": "biome format .",
    "lint": "biome lint --write .",
    "check": "biome check --write .",
    "package": "rollup --config rollup.config.ts --configPlugin @rollup/plugin-typescript",
    "test": "NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 jest",
    "all": "pnpm run build && pnpm run check && pnpm run package && pnpm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aki77/expiring-todo-comments-action"
  },
  "keywords": [
    "actions",
    "node",
    "setup"
  ],
  "author": "aki77",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@jest/globals": "^30.4.1",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^24.13.1",
    "jest": "^30.4.2",
    "js-yaml": "^4.2.0",
    "rollup": "^4.57.1",
    "ts-jest": "^29.4.11",
    "ts-jest-resolver": "^2.0.1",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@10.17.0+sha512.fce8a3dd29a4ed2ec566fb53efbb04d8c44a0f05bc6f24a73046910fb9c3ce7afa35a0980500668fa3573345bd644644fa98338fa168235c80f4aa17aa17fbef"
}
